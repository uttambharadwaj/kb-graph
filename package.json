{
  "name": "kb-graph",
  "version": "2.1.0",
  "description": "Shared memory for coding agents, stored in Markdown and SQLite.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uttambharadwaj/kb-graph.git"
  },
  "homepage": "https://github.com/uttambharadwaj/kb-graph#readme",
  "bugs": {
    "url": "https://github.com/uttambharadwaj/kb-graph/issues"
  },
  "keywords": [
    "ai-agents",
    "knowledge-base",
    "mcp",
    "memory",
    "sqlite"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "kb": "./bin/kb.js"
  },
  "files": [
    ".env.example",
    "bin/init-vault.sh",
    "bin/kb-checkpoint-hook.js",
    "bin/kb-trigger-hook.js",
    "bin/kb.js",
    "bin/weekly-synthesis.js",
    "docs/",
    "eval/checkpoint-replay-v1.json",
    "llms.txt",
    "openapi.json",
    "skills/",
    "src/"
  ],
  "scripts": {
    "pretest": "npm run test:preflight",
    "test": "npm run test:suite",
    "test:preflight": "node scripts/test-preflight.mjs",
    "test:suite": "node --test tests/*.test.js"
  },
  "engines": {
    "node": "22.x || 24.x || 26.x"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "better-auth": "1.6.22",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "gray-matter": "^4.0.3",
    "multer": "^2.3.0",
    "pdf-parse": "^1.1.1",
    "zod": "^4.5.4"
  }
}
